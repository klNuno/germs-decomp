#!/usr/bin/env bash
# Refuses game data, oversized files, protected-file edits and inline asm.
# Wire once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
fail=0

while IFS= read -r -d '' f; do
  case "$f" in
    disks/README.md) ;;
    disks/*|extract/*|asm/*|assets/*|build/*|expected/*|captures/*) echo "game data staged: $f"; fail=1 ;;
  esac
  # Disc images, executables and the game's own file types, wherever they are dropped
  case "${f##*/}" in
    SLPS_*.sha1) ;;
    SLPS_*|*.bin|*.cue|*.iso|*.img|*.chd|*.pbp|*.ecm|*.exe|*.EXE|*.[Ss][Tt][Rr]|*.[Tt][Ii][Mm]|*.[Vv][Hh]|*.[Vv][Bb]|*.[Ss][Ee][Qq]|*.[Xx][Aa]|*.mcd|*.mcr|*.srm|*.sav|*.rom|\
    RES.R|SCE.S|CITY.*|*.RM|*.BC|*.MP) echo "game file staged: $f"; fail=1 ;;
  esac
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt 1048576 ]; then echo "file over 1 MB staged: $f"; fail=1; fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Target hash, toolchain, build flags and these hooks change only on the maintainer's go (then GERMS_PROTECTED_OK=1).
protected='^(config/SLPS_021\.07\.sha1|tools/versions\.env|tools/toolchain\.sha256|tools/requirements\.lock|Makefile|tools/hooks/.*)$'
if [ "${GERMS_PROTECTED_OK:-0}" != 1 ] && git rev-parse -q --verify HEAD >/dev/null; then
  if git diff --cached --name-only | grep -qE "$protected"; then
    echo "protected file changed: needs the maintainer's go, then commit with GERMS_PROTECTED_OK=1"; fail=1
  fi
fi

# C sources: no inline asm, no forced registers. Exceptions: the INCLUDE_ASM header and the GTE macros
# (include/gte.h, the PSY-Q style COP2 macros the game was written with).
if git diff --cached -U0 -- '*.c' '*.h' ':!include/include_asm.h' ':!include/gte.h' | grep -E '^\+' \
  | grep -qE '(__asm__|\basm)[[:space:]]*(volatile[[:space:]]*)?\(|register[^;]*\basm\b'; then
  echo "inline asm or forced register in staged C"; fail=1
fi

exit $fail
