#!/usr/bin/env bash
# Licence: MIT for klNuno's own code only; game-derived data and Sony names in it are excluded (LICENSING.md).
# Refuses a push unless the tree builds the retail executable byte for byte and stays shiftable
# (no address the linker cannot move: tools/rawscan.py).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ ! -f extract/SLPS_021.07 ]; then echo "pre-push: no extract/, skipping make check (run make check-disk)"; exit 0; fi
[ -f linker/germs.ld ] || make -s split >/dev/null
make -s check
.venv/bin/python -I tools/rawscan.py --max 0 >/dev/null || { .venv/bin/python -I tools/rawscan.py | tail -20; echo "pre-push: raw addresses in the build, see tools/rawscan.py"; exit 1; }
